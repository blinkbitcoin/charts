{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ingress": {
      "type": "object",
      "required": [
        "limitRps",
        "limitRpm",
        "limitBurstMultiplier",
        "limitConnections"
      ],
      "properties": {
        "limitRps": {
          "type": "integer",
          "minimum": 1
        },
        "limitRpm": {
          "type": "integer",
          "minimum": 1
        },
        "limitBurstMultiplier": {
          "type": "integer",
          "minimum": 1
        },
        "limitConnections": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
